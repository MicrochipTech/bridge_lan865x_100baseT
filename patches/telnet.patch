-// Telnet's message 
+/* HAND-PATCH to MCC-generated code, documented exception (CLAUDE.md section 3):
+ * bounded wait for TX buffer space before writing, pumping the network stack
+ * ourselves (APP_PumpNetworkStack(), app.c) instead of just busy-spinning,
+ * PLUS retrying on the actual NET_PRES_SocketWrite() return value instead of
+ * discarding it.
+ *
+ * A plain busy-wait here (tried first, 2026-08-31) doesn't work: in this
+ * bare-metal, single-superloop build, SYS_CMD_Tasks() - which is what calls a
+ * command handler and, through it, this function - runs BEFORE
+ * TCPIP_STACK_Task()/NET_PRES_Tasks() in SYS_Tasks() (config/default/tasks.c).
+ * Unlike UART TX (drained by a hardware interrupt that keeps firing no matter
+ * what the main loop is doing), nothing drains a Telnet socket's TX buffer
+ * until those two functions actually run - so a bare
+ * NET_PRES_SocketWriteIsReady() wait, even adding NET_PRES_SocketFlush(),
+ * just burns its full timeout every time: measured "dump 800" over Telnet at
+ * 3075-3093 of ~4011 bytes, 6.6s, vs. near-instant before this patch existed.
+ * APP_PumpNetworkStack() runs exactly those two functions out of turn to
+ * unblock this. Safe here specifically because F_Telnet_MSG() is only ever
+ * reached via the SYS_CMD_API .msg/.print callback (no other caller in this
+ * file) - i.e. only from SYS_CMD_Tasks()'s call chain, a sibling of
+ * TCPIP_STACK_Task() in SYS_Tasks(), never nested inside it - so this is an
+ * extra out-of-turn call, not a reentrant one.
+ *
+ * A first version of this fix pre-checked NET_PRES_SocketWriteIsReady() for
+ * the full length, then wrote once and discarded the return value - same
+ * "fire and forget" bug as SERCOM1_USART_Write() on the serial side. Measured
+ * 2026-08-31 with "dump 0x20000000 32000" over Telnet: intermittently (not
+ * every run - a timing race, not a fixed size limit) one line's tail went
+ * missing and the next line's bytes landed right where it should have been,
+ * e.g. "...00   .........20000940:  00 00..." (9 of 16 ASCII dots, then the
+ * NEXT line's address, no "\n\r" between them at all) - i.e. the readiness
+ * check does not reliably predict what a single NET_PRES_SocketWrite() call
+ * actually accepts. Fixed by looping on the real return value, exactly like
+ * the readiness check was supposed to guarantee but didn't. */
+#define F_TELNET_MSG_WAIT_MS  500U
+
+// Telnet's message
 static void F_Telnet_MSG(const void* cmdIoParam, const char* str)
 {
     NET_PRES_SKT_HANDLE_T tSkt = (NET_PRES_SKT_HANDLE_T)FC_CvPtr2U32(cmdIoParam);
     if(tSkt != INVALID_SOCKET)
     {
-        (void)NET_PRES_SocketWrite(tSkt, FC_CStr2CVPtr(str), (uint16_t)strlen(str));
+        uint16_t len = (uint16_t)strlen(str);
+        uint16_t sent = 0U;
+        uint64_t deadline = SYS_TIME_Counter64Get()
+            + (((uint64_t)SYS_TIME_FrequencyGet() * (uint64_t)F_TELNET_MSG_WAIT_MS) / 1000ULL);
+
+        while(sent < len)
+        {
+            uint16_t remaining = (uint16_t)(len - sent);
+            uint16_t n = (uint16_t)NET_PRES_SocketWrite(tSkt, FC_CStr2CVPtr(&str[sent]), remaining);
+            if(n > 0U)
+            {
+                sent = (uint16_t)(sent + n);
+                continue;
+            }
+            if((int64_t)(SYS_TIME_Counter64Get() - deadline) >= 0)
+            {
+                break;   /* peer/stack not draining fast enough - give up on the rest, same as before this patch */
+            }
+            APP_PumpNetworkStack();
+        }
+        (void)NET_PRES_SocketFlush(tSkt);
     }
 }
 

diff --git a/apps/bridge_lan865x_100baseT/firmware/src/config/default/driver/lan865x/src/dynamic/tc6/tc6-conf.h b/apps/bridge_lan865x_100baseT/firmware/src/config/default/driver/lan865x/src/dynamic/tc6/tc6-conf.h
index 8900262..3c1fbba 100644
--- a/apps/bridge_lan865x_100baseT/firmware/src/config/default/driver/lan865x/src/dynamic/tc6/tc6-conf.h
+++ b/apps/bridge_lan865x_100baseT/firmware/src/config/default/driver/lan865x/src/dynamic/tc6/tc6-conf.h
@@ -135,8 +135,20 @@ extern "C" {
  * \brief Defines the amount of Ethernet segments available to the TC6_GetSendRawSegments and TC6_SendRawEthernetSegments
  * \note If TC6_GetSendRawSegments and TC6_SendRawEthernetSegments are not used set it to 1. Otherwise set the worst case amount of Ethernet segments generated by TCP/IP stack.
  */
+/* HAND-PATCH to MCC-generated code, documented exception (CLAUDE.md section 3):
+ * was 1u - too low for the bridge's own TCP stack: tcp.c's F_Tcpv4LinkDataSeg()
+ * links at most 2 data segments to a TCP socket, plus the header segment -
+ * worst case 3, not 1. At 1u every multi-segment TCP packet the bridge itself
+ * sends (not merely forwards) was rejected by DRV_LAN865X_PacketTx() and hit
+ * the TCPIP Stack Assert in TCPIPStackPacketTx() (tcpip_manager.c:5349) -
+ * live-verified 2026-09-01 via the iperf matrix test (Bridge -> FollowerA/B
+ * TCP both failed at 0.00 Mbit/s, "stats" showed eth0 err>0 but qFull=0,
+ * pinpointing the "Not enough TC6 Segments" branch, not a full TX queue).
+ * Same fix as the sister project (t1s_100baset_bridge) and this repo's own
+ * apps/follower_lan865x, both already at 3u. Re-runs of Generate Code that
+ * touch this file reset it to 1u - reapply after every regenerate. */
 #ifndef TC6_TX_ETH_MAX_SEGMENTS
-#define TC6_TX_ETH_MAX_SEGMENTS    (1u)
+#define TC6_TX_ETH_MAX_SEGMENTS    (3u)
 #endif
 

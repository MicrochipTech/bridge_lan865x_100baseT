# Per-machine tool state (written by the GUI tools' own setup dialogs / probe
# selection) - never means anything on another machine or bench, so never
# commit it. Same convention as the related in-house project this was ported from.
json/bench.json
json/term_ports.json

# Own Python virtual environment (see setup.bat / batch\setup_venv.bat) -
# machine-specific, recreated by setup.bat on a fresh clone.
.venv/

# Advisory record of the intended XC32 version (see scripts\setup_compiler.py) -
# machine-specific, not read by build.bat itself.
setup_compiler.config

# AI-assistant working instructions - personal workflow/machine-specific
# (local screenshot folder, session-log habit), not project documentation.
# The actual project knowledge lives in docs\ and is tracked normally.
CLAUDE.md

# MPLAB X build fragments - generated per machine by prjMakefilesGenerator
# (see batch\genmk.bat / build.bat, README section 5.2). They hold absolute
# paths of the machine that generated them (Makefile-local-default.mk carries
# the XC32 and MPLAB X install paths verbatim), so they never mean anything on
# another bench. Only nbproject\configurations.xml and nbproject\project.xml
# are tracked; everything derived from them is regenerated on a fresh clone.
firmware/tcpip_iperf_lan865x.X/nbproject/Makefile-*
firmware/tcpip_iperf_lan865x.X/nbproject/private/
firmware/tcpip_iperf_lan865x.X/.generated_files/

# Python bytecode cache of the host-side scripts (scripts\*.py).
__pycache__/

# MPLAB X build output - object files, dependency lists, linker output and the
# timestamped image archive scripts\build_summary.py keeps. Derived from the
# tracked sources by build.bat and rewritten on every build (164 .o plus 164 .d,
# ~14 MB); a fresh clone has neither directory until it builds once.
firmware/tcpip_iperf_lan865x.X/build/
firmware/tcpip_iperf_lan865x.X/dist/

# Raw run logs the test scripts append to on the machine that runs them
# (scripts\iperf_matrix_test.py, scripts\sniffer_capture_test.py). Bench- and
# run-specific; the summarised results are what gets committed, under docs\.
docs/iperf_matrix_results.log
docs/sniffer_capture_results.log

# Throwaway material scripts\testplan_runner.py generates for its negative
# tests: a self-signed CA the project deliberately does NOT trust, used to
# prove that a foreign-CA client certificate is rejected. Regenerated on
# demand; never a trusted part of the project's PKI (that lives in certs\).
scripts/_testplan_scratch/

# Locally generated PKI material (scripts\pki.py). Only the DEFAULT identity
# is part of the repo: certs\default\ and its compiled form
# firmware\src\bridge_certs.h, which every board runs until an individual
# identity is pushed to it, plus certs\ca\ (still bring-up material - see
# docs\pki-clean-start.md and docs\tls-poc-report.md sec.12 for why the CA key
# being here is a deliberate, documented compromise).
#
# Everything below is created per checkout and per bench and must never be
# committed: a board identity is one board's private key, and a checked-in one
# would silently make every clone of this repo able to impersonate that board.
# docs\pki-clean-start.md is the procedure that recreates all of it.
certs/boards/
certs/client/
certs/mqtt/
json/boards/

# Fuse backups written by fuses.bat before every fuse write (scripts/fuses_same54.py):
# one chip's factory calibration and settings, bound to that chip's serial number.
# Meaningless on any other board - fuses.bat refuses to restore one there anyway.
json/fuse_backups/
